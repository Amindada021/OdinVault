<Window x:Class="OdinVault.Manager.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OdinVault Manager" Width="1440" Height="900" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="10">
   <DockPanel>
    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="OdinVault" FontSize="25" FontWeight="Bold" Margin="10,12,10,2"/><TextBlock Text="Backup Control Center" Foreground="{DynamicResource MutedBrush}" Margin="10,0,10,16"/>
     <Button Tag="NavActive" Style="{StaticResource NavButton}" Content="{DynamicResource NavDashboard}" Click="Dashboard_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavDatabases}" Click="Databases_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavBackups}" Click="Backups_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavStorage}" Click="Storage_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavRestore}" Click="Restore_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavAlerts}" Click="Alerts_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavReports}" Click="Reports_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavMobile}" Click="Mobile_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavSettings}" Click="Settings_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavUpdate}" Click="Update_Click"/><Button Tag="Nav" Style="{StaticResource NavButton}" Content="{DynamicResource NavAbout}" Click="About_Click"/>
    </StackPanel></ScrollViewer>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding AgentStatus}" FontWeight="SemiBold" Margin="8"/><TextBlock Text="OdinVault Manager" Foreground="{DynamicResource MutedBrush}" Margin="8"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="DashboardPanel" Grid.Column="1" Margin="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="5,0,5,12"><StackPanel DockPanel.Dock="Right"><TextBlock Text="{DynamicResource DashboardTitle}" FontSize="24" FontWeight="Bold"/><TextBlock Text="وضعیت حفاظت، بکاپ‌ها و Agent" Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Style="{StaticResource GhostButton}" Content="☾ / ☀" Click="Theme_Click"/><Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}"/></StackPanel></DockPanel>
   <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"><TextBlock Text="در حال بروزرسانی داشبورد…" Visibility="{Binding IsLoading,Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Error}" Visibility="{Binding HasError,Converter={StaticResource BoolToVisibility}}" Foreground="#C2413B" TextWrapping="Wrap"/></StackPanel>
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="دیتابیس‌های محافظت‌شده" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ProtectedValue}" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="خطاهای ۲۴ ساعت اخیر" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding FailedValue}" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="عملیات فعال" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ActiveValue}" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="فضای آزاد بکاپ" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding StorageValue}" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
   </UniformGrid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="فعالیت‌های اخیر" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid ItemsSource="{Binding Activities}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="دیتابیس" Binding="{Binding Database}" Width="*"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="زمان" Binding="{Binding Time}" Width="170"/></DataGrid.Columns></DataGrid></DockPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="نیازمند توجه" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/><ListBox ItemsSource="{Binding Attention}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Database}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   </Grid>
  </Grid>
  <ContentControl x:Name="PageHost" Grid.Column="1" Visibility="Collapsed"/>
 </Grid>
</Window>