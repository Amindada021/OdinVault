<Window x:Class="OdinVault.Manager.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OdinVault Manager — WPF Preview" Width="1440" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="OdinVault" FontSize="25" FontWeight="Bold" Margin="8,12,8,2"/><TextBlock Text="Backup Control Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0,8,24"/>
     <Button Style="{StaticResource NavButton}" Content="⌂  داشبورد" Click="Dashboard_Click"/><Button Style="{StaticResource NavButton}" Content="▣  دیتابیس‌ها" Click="Databases_Click"/><Button Style="{StaticResource NavButton}" Content="◫  بکاپ‌ها" Click="Backups_Click"/><Button Style="{StaticResource NavButton}" Content="◈  ذخیره‌سازی" Click="Storage_Click"/><Button Style="{StaticResource NavButton}" Content="↶  بازیابی" Click="Restore_Click"/><Button Style="{StaticResource NavButton}" Content="⚠  هشدارها" Click="Alerts_Click"/><Button Style="{StaticResource NavButton}" Content="▤  گزارش‌ها" Click="Reports_Click"/><Button Style="{StaticResource NavButton}" Content="⚙  تنظیمات" Click="Settings_Click"/><Button Style="{StaticResource NavButton}" Content="⬆  بروزرسانی" Click="Update_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding AgentStatus}" FontWeight="SemiBold" Margin="8"/><TextBlock Text="Phase 1 · WPF Preview" Foreground="{DynamicResource MutedBrush}" Margin="8"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="DashboardPanel" Grid.Column="1" Margin="26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="6,0,6,18"><StackPanel DockPanel.Dock="Right"><TextBlock Text="داشبورد" FontSize="28" FontWeight="Bold"/><TextBlock Text="وضعیت حفاظت، بکاپ‌ها و Agent" Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="☾ / ☀" Click="Theme_Click"/><Button Content="بروزرسانی" Command="{Binding RefreshCommand}"/></StackPanel></DockPanel>
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="دیتابیس‌های محافظت‌شده" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ProtectedValue}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="خطاهای ۲۴ ساعت اخیر" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding FailedValue}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="عملیات فعال" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ActiveValue}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="فضای آزاد بکاپ" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding StorageValue}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
   </UniformGrid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="فعالیت‌های اخیر" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/><DataGrid ItemsSource="{Binding Activities}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="دیتابیس" Binding="{Binding Database}" Width="*"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="زمان" Binding="{Binding Time}" Width="170"/></DataGrid.Columns></DataGrid></DockPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="نیازمند توجه" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/><ListBox ItemsSource="{Binding Attention}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Database}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   </Grid>
  </Grid>
  <ContentControl x:Name="PageHost" Grid.Column="1" Visibility="Collapsed"/>
 </Grid>
</Window>