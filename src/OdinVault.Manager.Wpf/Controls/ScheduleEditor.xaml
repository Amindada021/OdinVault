<UserControl x:Class="OdinVault.Manager.Wpf.Controls.ScheduleEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><ComboBox x:Name="Mode" SelectionChanged="Changed"><ComboBoxItem Content="دستی"/><ComboBoxItem Content="روزانه یک‌بار"/><ComboBoxItem Content="پیشرفته (Cron / UTC)"/></ComboBox><StackPanel x:Name="TimePanel" Margin="0,6,0,0"><TextBlock Text="ساعت تهران"/><TextBox x:Name="Time" Text="02:00" TextChanged="Changed" FlowDirection="LeftToRight"/></StackPanel><StackPanel x:Name="AdvancedPanel" Margin="0,6,0,0"><TextBlock Text="Cron پیشرفته (UTC)"/><TextBox x:Name="Cron" TextChanged="Changed" Style="{StaticResource TechnicalText}"/></StackPanel><TextBlock x:Name="Summary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></UserControl>