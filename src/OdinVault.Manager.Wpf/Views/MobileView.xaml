<UserControl x:Class="OdinVault.Manager.Wpf.Views.MobileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft"><ScrollViewer><StackPanel Margin="26"><TextBlock Text="اتصال موبایل" FontSize="28" FontWeight="Bold" Margin="6,0,6,18"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="آدرس اتصال موبایل" FontSize="18" FontWeight="Bold"/><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><ComboBox SelectedValue="{Binding Scheme}" SelectedValuePath="Content"><ComboBoxItem Content="http"/><ComboBoxItem Content="https"/></ComboBox><TextBox Grid.Column="1" Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TechnicalText}"/><TextBox Grid.Column="2" Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TechnicalText}"/></Grid><TextBlock Text="{Binding Preview}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal"><Button Content="ذخیره آدرس" Click="Save_Click"/><Button Content="تست Agent" Click="Agent_Click"/><Button Content="بررسی Port" Click="Port_Click"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="4,10"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="API Key" FontSize="18" FontWeight="Bold"/><TextBox Text="{Binding ApiKey}" IsReadOnly="True" Style="{StaticResource TechnicalText}"/><TextBlock Text="کلید را فقط روی دستگاه‌های مورد اعتماد وارد کنید." Foreground="{DynamicResource MutedBrush}" Margin="0,8"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>