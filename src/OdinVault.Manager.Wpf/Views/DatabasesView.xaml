<UserControl x:Class="OdinVault.Manager.Wpf.Views.DatabasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="6,0,6,18"><StackPanel DockPanel.Dock="Right"><TextBlock Text="دیتابیس‌ها" FontSize="28" FontWeight="Bold"/><TextBlock Text="وضعیت اتصال و حفاظت دیتابیس‌های ثبت‌شده" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Button DockPanel.Dock="Left" Content="بروزرسانی" Command="{Binding RefreshCommand}"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}">
   <Grid><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected,Mode=TwoWay}" SelectionMode="Single" SelectionUnit="FullRow" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowHeight="44" HeadersVisibility="Column">
    <DataGrid.Columns><DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="دیتابیس" Binding="{Binding DatabaseName}" Width="1.2*"/><DataGridTextColumn Header="سرور" Binding="{Binding Host}" Width="1.3*"/><DataGridTextColumn Header="وضعیت" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="حفاظت" Binding="{Binding Protection}" Width="130"/><DataGridTextColumn Header="آخرین بکاپ" Binding="{Binding LastBackup}" Width="160"/><DataGridTextColumn Header="حجم" Binding="{Binding Size}" Width="100"/></DataGrid.Columns>
   </DataGrid>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="در حال دریافت دیتابیس‌ها…" Visibility="{Binding IsLoading,Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource MutedBrush}" FontSize="16"/><TextBlock Text="{Binding Error}" Visibility="{Binding HasError,Converter={StaticResource BoolToVisibility}}" Foreground="#C2413B" TextWrapping="Wrap" MaxWidth="520"/><TextBlock Text="هنوز دیتابیسی ثبت نشده است." Visibility="{Binding HasNoItems,Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource MutedBrush}" FontSize="16"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Column="1" Style="{StaticResource Card}">
   <Grid><StackPanel>
    <TextBlock Text="جزئیات دیتابیس" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
    <TextBlock Text="یک دیتابیس را انتخاب کنید." Foreground="{DynamicResource MutedBrush}"/>
    <TextBlock Text="در حال دریافت جزئیات…" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding IsDetailsLoading,Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding DetailsError}" Foreground="#C2413B" TextWrapping="Wrap" Visibility="{Binding HasDetailsError,Converter={StaticResource BoolToVisibility}}"/>
    <StackPanel Visibility="{Binding HasDetails,Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="{Binding Details.Name}" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Details.DatabaseName}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10"/><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button Content="تست اتصال" Command="{Binding TestCommand}"/><Button Content="اجرای بکاپ" Command="{Binding BackupCommand}"/></StackPanel><TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="سرور" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.Host}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,2,0,10"/>
     <TextBlock Text="وضعیت حفاظت" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.Protection}" FontWeight="SemiBold" Margin="0,2,0,10"/>
     <TextBlock Text="آخرین بکاپ" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.LastBackup}" Margin="0,2,0,10"/>
     <UniformGrid Columns="2" Margin="0,2,0,10"><StackPanel><TextBlock Text="Backup" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.BackupStatus}" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="Verification" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.Verification}" FontWeight="SemiBold"/></StackPanel></UniformGrid>
     <TextBlock Text="Replica" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.Replica}" Margin="0,2,0,10"/>
     <TextBlock Text="زمان‌بندی" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.Schedule}" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,2,0,10"/>
     <TextBlock Text="مسیر بکاپ" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Details.BackupPath}" FlowDirection="LeftToRight" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,14"/><TextBlock Text="آخرین بکاپ‌ها" FontWeight="Bold" Margin="0,4,0,6"/><ItemsControl ItemsSource="{Binding BackupHistory}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Text="{Binding Verification}" Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Size}" FlowDirection="LeftToRight"/><TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Replicaهای اخیر" FontWeight="Bold" Margin="0,14,0,6"/><ItemsControl ItemsSource="{Binding ReplicaHistory}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock DockPanel.Dock="Right" Text="{Binding Name}"/><TextBlock DockPanel.Dock="Left" Text="{Binding Status}" FontWeight="SemiBold"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </StackPanel></Grid>
  </Border></Grid>
 </Grid>
</UserControl>