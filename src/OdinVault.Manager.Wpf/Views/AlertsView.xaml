<UserControl x:Class="OdinVault.Manager.Wpf.Views.AlertsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="6,0,6,18"><TextBlock DockPanel.Dock="Right" Text="هشدارها" FontSize="28" FontWeight="Bold"/><TextBlock DockPanel.Dock="Left" Text="{Binding Unread,StringFormat=خوانده‌نشده: {0}}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="شدت" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="دیتابیس" Binding="{Binding Database}" Width="150"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="پیام" Binding="{Binding Message}" Width="1.5*"/><DataGridTextColumn Header="زمان" Binding="{Binding Time}" Width="170"/><DataGridTextColumn Header="وضعیت" Binding="{Binding State}" Width="100"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>