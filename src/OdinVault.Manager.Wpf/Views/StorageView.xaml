<UserControl x:Class="OdinVault.Manager.Wpf.Views.StorageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ذخیره‌سازی" FontSize="28" FontWeight="Bold" Margin="6,0,6,18"/><UniformGrid Grid.Row="1" Columns="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="مسیر محلی" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Local}" FlowDirection="LeftToRight" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="فضای آزاد" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Free}" FontSize="24" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="تست اتصال" Command="{Binding TestCommand}"/><TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" Margin="12,0"/></StackPanel><Grid><DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="وضعیت" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="اتصال" Binding="{Binding Connection}" Width="100"/><DataGridTextColumn Header="دیتابیس‌ها" Binding="{Binding Databases}" Width="90"/><DataGridTextColumn Header="موفق" Binding="{Binding Success}" Width="80"/><DataGridTextColumn Header="خطا" Binding="{Binding Failed}" Width="80"/><DataGridTextColumn Header="آخرین فعالیت" Binding="{Binding Activity}" Width="170"/><DataGridTextColumn Header="آخرین خطا" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="در حال دریافت مقصدهای ذخیره‌سازی…" Visibility="{Binding IsLoading,Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding Error}" Foreground="#C2413B" TextWrapping="Wrap" Visibility="{Binding HasError,Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="مقصد ذخیره‌سازی ثبت نشده است." Visibility="{Binding HasNoItems,Converter={StaticResource BoolToVisibility}}"/></StackPanel></Grid></DockPanel></Border></Grid></UserControl>