<Window x:Class="OdinVault.Manager.Wpf.Views.DatabaseEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تنظیم دیتابیس" Width="650" SizeToContent="Height" WindowStartupLocation="CenterOwner"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="6"><TextBlock Text="نام"/><TextBox x:Name="NameBox"/><TextBlock Text="SQL Server" Margin="0,8,0,0"/><TextBox x:Name="HostBox" Style="{StaticResource TechnicalText}"/><TextBlock Text="Port" Margin="0,8,0,0"/><TextBox x:Name="PortBox" Style="{StaticResource TechnicalText}"/><TextBlock Text="Database" Margin="0,8,0,0"/><TextBox x:Name="DatabaseBox" Style="{StaticResource TechnicalText}"/><TextBlock Text="Username" Margin="0,8,0,0"/><TextBox x:Name="UsernameBox" Style="{StaticResource TechnicalText}"/><TextBlock Text="Password" Margin="0,8,0,0"/><PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"/><CheckBox x:Name="TrustBox" Content="Trust Server Certificate" IsChecked="True" Margin="0,10"/><CheckBox x:Name="EnabledBox" Content="فعال" IsChecked="True"/></StackPanel><StackPanel Grid.Column="1" Margin="6"><TextBlock Text="مسیر بکاپ"/><TextBox x:Name="BackupBox" Style="{StaticResource TechnicalText}"/><TextBlock Text="تعداد نگهداری" Margin="0,8,0,0"/><TextBox x:Name="MaxBox" Text="7"/><CheckBox x:Name="VerifyBox" Content="Verify بعد از بکاپ" IsChecked="True" Margin="0,10"/><TextBlock Text="Cron زمان‌بندی"/><TextBox x:Name="CronBox" Style="{StaticResource TechnicalText}"/><TextBlock Text="برای غیرفعال بودن زمان‌بندی، Cron را خالی بگذارید." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="ذخیره" Click="Save_Click" IsDefault="True"/><Button Content="انصراف" IsCancel="True"/></StackPanel></StackPanel></Grid></Window>