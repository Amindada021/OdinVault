<Window x:Class="OdinVault.Manager.Wpf.Views.ReplicaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="مدیریت Replica" Width="900" Height="720" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner"><TabControl Margin="18"><TabItem Header="ارسال به سرور پشتیبان"><ScrollViewer><StackPanel Margin="14"><TextBlock Text="مقصدهای ثبت‌شده"/><ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Name" Margin="0,5,0,12"/><TextBlock Text="نام مقصد جدید"/><TextBox Text="{Binding Name}" Margin="0,5,0,8"/><TextBlock Text="آدرس سرور پشتیبان"/><TextBox Text="{Binding Url}" Style="{StaticResource TechnicalText}" Margin="0,5,0,8"/><TextBlock Text="API Key سرور پشتیبان"/><TextBox Text="{Binding Key}" Style="{StaticResource TechnicalText}" Margin="0,5,0,8"/><Button Content="افزودن مقصد" Click="Add_Click" HorizontalAlignment="Right"/><TextBlock Text="دیتابیس‌هایی که بکاپشان به این مقصد ارسال شود" FontWeight="Bold" Margin="0,18,0,8"/><DataGrid ItemsSource="{Binding Databases}" AutoGenerateColumns="False" Height="230"><DataGrid.Columns><DataGridCheckBoxColumn Header="ارسال" Binding="{Binding Linked}" Width="80"/><DataGridTextColumn Header="دیتابیس" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid><Button Content="ذخیره اتصال دیتابیس‌ها" Click="Links_Click" HorizontalAlignment="Right" Margin="0,10"/></StackPanel></ScrollViewer></TabItem><TabItem Header="این سرور محل دریافت است"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="پوشه دریافت بکاپ"/><TextBox Text="{Binding Folder}" Style="{StaticResource TechnicalText}" Margin="0,5"/><Button Content="ذخیره مسیر و بروزرسانی فایل‌ها" Click="Folder_Click" HorizontalAlignment="Right"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Received}" AutoGenerateColumns="False" Margin="0,14,0,0" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="فایل / سرور / دیتابیس" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="حجم" Binding="{Binding Size}" Width="110"/><DataGridTextColumn Header="دریافت" Binding="{Binding Date}" Width="180"/></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl></Window>