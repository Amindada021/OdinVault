<Window x:Class="OdinVault.Manager.Wpf.Views.ReplicaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مقصدهای Replica"
        Width="900" Height="680"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Text="ارسال بکاپ به سرورهای دیگر"
                       FontSize="22" FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="در این صفحه مقصدهای بکاپ این سرور را تعریف می‌کنید. مسیر ذخیره‌سازی هر مقصد باید روی خود همان سرور مقصد تنظیم شود."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,18"/>

            <TextBlock Text="مقصدهای ثبت‌شده"/>
            <ComboBox ItemsSource="{Binding Targets}"
                      SelectedItem="{Binding Target}"
                      DisplayMemberPath="Name"
                      Margin="0,5,0,12"/>

            <TextBlock Text="نام مقصد جدید"/>
            <TextBox Text="{Binding Name}" Margin="0,5,0,8"/>

            <TextBlock Text="آدرس Agent سرور مقصد"/>
            <TextBox Text="{Binding Url}"
                     Style="{StaticResource TechnicalText}"
                     Margin="0,5,0,8"/>

            <TextBlock Text="API Key سرور مقصد"/>
            <TextBox Text="{Binding Key}"
                     Style="{StaticResource TechnicalText}"
                     Margin="0,5,0,4"/>
            <TextBlock Text="پس از ذخیره، کلید دوباره نمایش داده نمی‌شود؛ آدرس مقصد باقی می‌ماند."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,8"/>

            <Button Content="افزودن و تست مقصد"
                    Click="Add_Click"
                    HorizontalAlignment="Right"/>

            <TextBlock Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>

            <TextBlock Text="دیتابیس‌هایی که بکاپشان به این مقصد ارسال شود"
                       FontWeight="Bold"
                       Margin="0,18,0,8"/>

            <DataGrid ItemsSource="{Binding Databases}"
                      AutoGenerateColumns="False"
                      Height="230">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="ارسال"
                                            Binding="{Binding Linked}"
                                            Width="80"/>
                    <DataGridTextColumn Header="دیتابیس"
                                        Binding="{Binding Name}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="یک دیتابیس می‌تواند همزمان به چند مقصد Replica متصل باشد؛ مقصد را از بالای صفحه انتخاب و تیک‌های همان مقصد را ذخیره کنید."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,8,0,0"/>

            <Button Content="ذخیره اتصال دیتابیس‌ها به این مقصد"
                    Click="Links_Click"
                    HorizontalAlignment="Right"
                    Margin="0,10"/>
        </StackPanel>
    </ScrollViewer>
</Window>