<UserControl x:Class="OdinVault.Manager.Wpf.Views.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="6,0,6,18"><StackPanel DockPanel.Dock="Right"><TextBlock Text="{DynamicResource PageBackups}" FontSize="28" FontWeight="Bold"/><TextBlock Text="عملیات جاری و تاریخچه بکاپ" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Button DockPanel.Dock="Left" Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="عملیات جاری" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><Grid><DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" Height="160"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource ColDatabase}" Binding="{Binding Database}" Width="*"/><DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="مرحله" Binding="{Binding Stage}" Width="160"/><DataGridTextColumn Header="{DynamicResource ColProgress}" Binding="{Binding Percent}" Width="90"/><DataGridTextColumn Header="آخرین تغییر" Binding="{Binding Updated}" Width="170"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="در حال دریافت عملیات بکاپ…" Visibility="{Binding IsLoading,Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="عملیات فعالی وجود ندارد." Visibility="{Binding HasNoJobs,Converter={StaticResource BoolToVisibility}}"/></StackPanel></Grid></StackPanel></Border><Border Grid.Row="2" Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="تاریخچه" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><Grid><DataGrid ItemsSource="{Binding Backups}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource ColDatabase}" Binding="{Binding Database}" Width="*"/><DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="صحت" Binding="{Binding Verification}" Width="120"/><DataGridTextColumn Header="{DynamicResource ColSize}" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="{DynamicResource ColStarted}" Binding="{Binding Started}" Width="170"/><DataGridTextColumn Header="فایل محلی" Binding="{Binding LocalFile}" Width="100"/><DataGridTextColumn Header="{DynamicResource ColError}" Binding="{Binding Error}" Width="1.2*"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Error}" Foreground="#C2413B" TextWrapping="Wrap" Visibility="{Binding HasError,Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="هنوز بکاپی ثبت نشده است." Visibility="{Binding HasNoBackups,Converter={StaticResource BoolToVisibility}}"/></StackPanel></Grid></DockPanel></Border></Grid></UserControl>