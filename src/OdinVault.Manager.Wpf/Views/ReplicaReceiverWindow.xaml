<Window x:Class="OdinVault.Manager.Wpf.Views.ReplicaReceiverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="محل دریافت Replica روی این سرور"
        Width="900" Height="620"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="محل دریافت Replica روی همین سرور"
                       FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="این تنظیم فقط روی سروری انجام می‌شود که قرار است بکاپ‌ها را دریافت کند. مثلاً اگر سرور ۱۸۸ مقصد است، این صفحه را روی خود ۱۸۸ تنظیم کنید."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,6,0,18"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="پوشه ذخیره بکاپ‌های دریافتی"/>
            <TextBox Text="{Binding Folder}"
                     Style="{StaticResource TechnicalText}"
                     Margin="0,5,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="ذخیره مسیر دریافت"
                        Click="Folder_Click"
                        HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding Status}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Received}"
                  AutoGenerateColumns="False"
                  Margin="0,18,0,0"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="فایل / سرور / دیتابیس"
                                    Binding="{Binding Path}"
                                    Width="*"/>
                <DataGridTextColumn Header="حجم"
                                    Binding="{Binding Size}"
                                    Width="110"/>
                <DataGridTextColumn Header="دریافت"
                                    Binding="{Binding Date}"
                                    Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>