<UserControl x:Class="OdinVault.Manager.Wpf.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft"><ScrollViewer><StackPanel Margin="26"><TextBlock Text="{DynamicResource PageSettings}" FontSize="28" FontWeight="Bold" Margin="6,0,6,18"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="رفتار برنامه" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/><CheckBox x:Name="StartMinimized" Content="شروع برنامه در Tray" Margin="0,6"/><CheckBox x:Name="MinimizeToTray" Content="با بستن پنجره، برنامه در Tray بماند" Margin="0,6"/><CheckBox x:Name="Notifications" Content="نمایش اعلان‌های Tray" Margin="0,6"/><CheckBox x:Name="AutoUpdate" Content="بررسی بروزرسانی هنگام شروع" Margin="0,6"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ظاهر" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Text="پوسته"/><ComboBox x:Name="Theme" SelectedValuePath="Tag"><ComboBoxItem Content="روشن" Tag="Light"/><ComboBoxItem Content="تیره" Tag="Dark"/></ComboBox><TextBlock Text="زبان" Margin="0,12,0,0"/><ComboBox x:Name="LanguageCombo" SelectedValuePath="Tag"><ComboBoxItem Content="فارسی" Tag="fa"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></StackPanel></Border><StackPanel Orientation="Horizontal"><Button Content="ذخیره تنظیمات" Click="Save_Click"/><TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0"/></StackPanel></StackPanel></ScrollViewer></UserControl>