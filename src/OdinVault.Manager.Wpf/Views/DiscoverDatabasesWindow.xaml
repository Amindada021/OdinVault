<Window x:Class="OdinVault.Manager.Wpf.Views.DiscoverDatabasesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="شناسایی دیتابیس‌های SQL Server" Width="1050" Height="740" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="5"><TextBlock Text="SQL Server"/><TextBox Text="{Binding Host}" Style="{StaticResource TechnicalText}"/><TextBlock Text="Username" Margin="0,8,0,0"/><TextBox Text="{Binding Username}" Style="{StaticResource TechnicalText}"/><TextBlock Text="مسیر بکاپ" Margin="0,8,0,0"/><TextBox Text="{Binding Backup}" Style="{StaticResource TechnicalText}"/></StackPanel><StackPanel Grid.Column="1" Margin="5"><TextBlock Text="Port"/><TextBox Text="{Binding Port}" Style="{StaticResource TechnicalText}"/><TextBlock Text="Password" Margin="0,8,0,0"/><PasswordBox x:Name="PasswordBox" PasswordChanged="Password_Changed" FlowDirection="LeftToRight"/><TextBlock Text="تعداد نگهداری" Margin="0,8,0,0"/><TextBox Text="{Binding Max}"/></StackPanel><StackPanel Grid.Column="2" Margin="5"><TextBlock Text="Cron زمان‌بندی"/><TextBox Text="{Binding Cron}" Style="{StaticResource TechnicalText}"/><CheckBox Content="Trust Server Certificate" IsChecked="{Binding Trust}" Margin="0,12,0,0"/><CheckBox Content="Verify بعد از بکاپ" IsChecked="{Binding Verify}" Margin="0,10,0,0"/></StackPanel></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,12"><Button Content="شناسایی دیتابیس‌ها" Click="Discover_Click"/><TextBlock Text="{Binding Status}" Margin="12,4" TextWrapping="Wrap"/></StackPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="انتخاب" Binding="{Binding Selected}" Width="70"/><DataGridTextColumn Header="دیتابیس" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="وضعیت" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Recovery" Binding="{Binding Recovery}" Width="120"/><DataGridTextColumn Header="دسترسی" Binding="{Binding Access}" Width="90"/><DataGridTextColumn Header="آماده بکاپ" Binding="{Binding Ready}" Width="100"/><DataGridTextColumn Header="ثبت‌شده" Binding="{Binding Registered}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,12,5,0"><Button Content="افزودن دیتابیس‌های انتخاب‌شده" Click="Add_Click"/><Button Content="بستن" IsCancel="True"/></StackPanel></Grid></Window>