<UserControl x:Class="OdinVault.Manager.Wpf.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="6,0,6,18"><TextBlock DockPanel.Dock="Right" Text="گزارش بکاپ" FontSize="28" FontWeight="Bold"/><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="بازه:" VerticalAlignment="Center" Margin="8,0"/><ComboBox Width="110" SelectedValue="{Binding Days}" SelectedValuePath="Tag"><ComboBoxItem Content="۷ روز" Tag="7"/><ComboBoxItem Content="۳۰ روز" Tag="30"/><ComboBoxItem Content="۹۰ روز" Tag="90"/></ComboBox><Button Content="بروزرسانی" Command="{Binding RefreshCommand}" Margin="8,0"/></StackPanel></DockPanel><UniformGrid Grid.Row="1" Columns="4"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="کل بکاپ"/><TextBlock Text="{Binding Total}" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="موفق"/><TextBlock Text="{Binding Success}" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ناموفق"/><TextBlock Text="{Binding Failed}" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="نرخ موفقیت"/><TextBlock Text="{Binding Rate}" FontSize="25" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding Databases}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="دیتابیس" Binding="{Binding Database}" Width="*"/><DataGridTextColumn Header="کل" Binding="{Binding Total}" Width="70"/><DataGridTextColumn Header="موفق" Binding="{Binding Success}" Width="80"/><DataGridTextColumn Header="ناموفق" Binding="{Binding Failed}" Width="80"/><DataGridTextColumn Header="خطای صحت‌سنجی" Binding="{Binding VerifyFailed}" Width="80"/><DataGridTextColumn Header="خطای پشتیبان" Binding="{Binding ReplicaFailed}" Width="80"/><DataGridTextColumn Header="نرخ" Binding="{Binding Rate}" Width="90"/><DataGridTextColumn Header="شدت" Binding="{Binding Severity}" Width="90"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>